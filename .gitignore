# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Captured image pairs and generated artifacts are data, not source.
data/pairs/left/*
data/pairs/right/*
!data/pairs/left/.gitkeep
!data/pairs/right/.gitkeep
output/*
!output/.gitkeep

# Calibration results are machine-specific; keep the folder, not the files.
calib/*
!calib/.gitkeep
